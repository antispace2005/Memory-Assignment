QMainWindow#mainWindow {
    background: #0b1020;
    color: #e5eefb;
}

QGroupBox {
    border: 1px solid #22314d;
    border-radius: 16px;
    margin-top: 12px;
    padding: 16px;
    background: #111a2f;
    color: #e5eefb;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    color: #9bc1ff;
}

QGroupBox#heroCard {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1, stop: 0 #15213d, stop: 1 #10192d);
    border: 1px solid #28406d;
}

QGroupBox#controlCard {
    background: #10192d;
}

QLabel#headerTitle {
    font-size: 24px;
    font-weight: 700;
    color: #f6fbff;
}

QLabel#headerSubtitle {
    color: #b7c7e6;
    font-size: 12px;
}

QLabel#statusLabel {
    color: #89e2b7;
    font-size: 12px;
    font-weight: 600;
    padding-top: 4px;
}

QComboBox,
QSpinBox {
    background: #0f172a;
    color: #e5eefb;
    border: 1px solid #304565;
    border-radius: 10px;
    padding: 8px 10px;
    min-height: 18px;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox QAbstractItemView {
    background: #10192d;
    color: #e5eefb;
    selection-background-color: #274774;
    border: 1px solid #304565;
}

QPushButton {
    border: none;
    border-radius: 12px;
    padding: 10px 14px;
    font-weight: 600;
    color: #f8fbff;
    background: #29406e;
}

QPushButton:hover {
    background: #355587;
}

QPushButton:pressed {
    background: #203557;
}

QPushButton#primaryButton {
    background: #2f7dd1;
}

QPushButton#primaryButton:hover {
    background: #4690e1;
}

QPushButton#accentButton {
    background: #17a673;
}

QPushButton#accentButton:hover {
    background: #1dbb83;
}

QTextEdit#activityLog {
    background: #09111f;
    color: #c8dbf6;
    border: 1px solid #22314d;
    border-radius: 12px;
    padding: 10px;
}

QTableWidget#holesTable,
QTableWidget#segmentsTable {
    background: #09111f;
    alternate-background-color: #0c1425;
    color: #edf4ff;
    gridline-color: #21304a;
    border: 1px solid #22314d;
    border-radius: 12px;
}

QTableWidget::item {
    padding: 6px;
}

QHeaderView::section {
    background: #15213d;
    color: #dce9fb;
    padding: 8px 10px;
    border: none;
    font-weight: 600;
}

QTableWidget::corner {
    background: #15213d;
}

QSplitter::handle {
    background: #22314d;
}

QToolBar {
    background: #0f172a;
    border: none;
    spacing: 8px;
    padding: 6px;
}

QToolButton {
    background: #1b2944;
    color: #edf4ff;
    border: 1px solid #2a4063;
    border-radius: 8px;
    padding: 6px 10px;
}

QToolButton:hover {
    background: #274165;
}
