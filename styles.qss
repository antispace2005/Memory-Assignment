/* --- Main Window & Globals --- */
QMainWindow#mainWindow {
    background: #0b1020;
    color: #e5eefb;
}

QLabel {
    color: #b7c7e6;
    font-weight: 500;
}

QLabel#statusLabel {
    color: #89e2b7;
    font-weight: 600;
}

/* --- Control Bar (Top Frame) --- */
QFrame#controlBar {
    background: #111a2f;
    border: 1px solid #22314d;
    border-radius: 4px;
}

/* --- Interactive Elements (Inputs & Dropdowns) --- */
QComboBox,
QSpinBox {
    background: #09111f;
    color: #e5eefb;
    border: 1px solid #304565;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 20px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: #111a2f;
    color: #e5eefb;
    selection-background-color: #274774;
    border: 1px solid #304565;
}

/* --- Buttons --- */
QPushButton {
    border: 1px solid #28406d;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: 600;
    color: #f8fbff;
    background: #1d2d4d;
}

QPushButton:hover {
    background: #2a406e;
    border-color: #3b5b9e;
}

QPushButton:pressed {
    background: #15213d;
}

/* --- Activity Log --- */
QTextEdit#activityLog {
    background: #09111f;
    color: #c8dbf6;
    border: 1px solid #22314d;
    border-radius: 4px;
    padding: 6px;
}

/* --- Tab Widget (Crucial for Minimal UI) --- */
QTabWidget::pane {
    border: 1px solid #22314d;
    border-radius: 4px;
    background: #09111f;
    /* This pulls the pane up to hide the bottom border of the active tab */
    top: -1px; 
}

QTabBar::tab {
    background: #111a2f;
    color: #b7c7e6;
    border: 1px solid #22314d;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 4px 12px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #09111f;
    color: #f6fbff;
    font-weight: 600;
    /* Blend the active tab into the pane below it */
    border-bottom: 1px solid #09111f; 
}

QTabBar::tab:hover:!selected {
    background: #15213d;
}

/* --- Tables --- */
QTableWidget {
    background: transparent;
    alternate-background-color: #0c1425;
    color: #edf4ff;
    gridline-color: #21304a;
    border: none;
}

QTableWidget::item {
    padding: 4px;
}

QHeaderView::section {
    background: #111a2f;
    color: #9bc1ff;
    padding: 4px 6px;
    border: 1px solid #21304a;
    border-top: none;
    border-left: none;
    font-weight: 600;
}

QTableWidget::corner {
    background: #111a2f;
}

/* --- Window Splitter --- */
QSplitter::handle {
    background: transparent;
    width: 6px;
}

QSplitter::handle:hover {
    background: #22314d;
}